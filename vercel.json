{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/gateway/:path*",
      "destination": "/api/gateway?path=:path*"
    },
    {
      "source": "/api/media/:path*",
      "destination": "/api/media?path=:path*"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
