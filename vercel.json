{
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/api/ytmusic/:path*",
      "destination": "/api/ytmusic?path=:path*"
    },
    {
      "source": "/api/yt/:path*",
      "destination": "/api/yt?path=:path*"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
